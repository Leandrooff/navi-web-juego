// Estado global de accesibilidad y audio
let synth = window.speechSynthesis;
let lecturaActual = null;
let volumenGlobal = 1;
let sonidoActivado = true;
const tamanosLetra = ['letra-normal', 'letra-grande', 'letra-extragrande'];
let indiceTamano = 0;

// Inicializa tamaño por defecto
document.body.classList.add(tamanosLetra[indiceTamano]);

/**
 * Lee el texto ingresado en voz alta mediante Web Speech API
 * @param {string} texto - Texto de la escena a sintetizar
 */
function leerTexto(texto) {
  if (!sonidoActivado) return;

  detenerAudio();

  if ('speechSynthesis' in window) {
    lecturaActual = new SpeechSynthesisUtterance(texto);
    lecturaActual.lang = 'es-ES';
    lecturaActual.volume = volumenGlobal;

    lecturaActual.onstart = () => actualizarIndicadorAudio(true, 'Reproduciendo...');
    lecturaActual.onend = () => actualizarIndicadorAudio(false, 'En reposo');
    lecturaActual.onerror = () => actualizarIndicadorAudio(false, 'Error de audio');

    synth.speak(lecturaActual);
  } else {
    alert('Tu navegador no admite la síntesis de voz automática.');
  }
}

/**
 * Detiene cualquier locución que esté sonando actualmente
 */
function detenerAudio() {
  if (synth && synth.speaking) {
    synth.cancel();
  }
  actualizarIndicadorAudio(false, 'En reposo');
}

/**
 * Controla el volumen del sintetizador (0.0 a 1.0)
 * @param {number|string} valor 
 */
function cambiarVolumen(valor) {
  volumenGlobal = parseFloat(valor);
  const btn = document.getElementById('btn-silenciar');
  if (volumenGlobal === 0) {
    sonidoActivado = false;
    if (btn) btn.innerText = '🔕 Mute';
  } else {
    sonidoActivado = true;
    if (btn) btn.innerText = '🔔 Sonido Activo';
  }
}

/**
 * Alterna entre activar o deshabilitar globalmente el sonido
 */
function alternarSonido() {
  sonidoActivado = !sonidoActivado;
  const btn = document.getElementById('btn-silenciar');
  
  if (!sonidoActivado) {
    detenerAudio();
    if (btn) btn.innerText = '🔕 Mute';
  } else {
    if (btn) btn.innerText = '🔔 Sonido Activo';
  }
}

/**
 * Alterna cíclicamente entre 3 tamaños de fuente
 */
function aumentarLetra() {
  document.body.classList.remove(tamanosLetra[indiceTamano]);
  indiceTamano = (indiceTamano + 1) % tamanosLetra.length;
  document.body.classList.add(tamanosLetra[indiceTamano]);
}

/**
 * Activa o desactiva el tema de alto contraste
 */
function activarContraste() {
  document.body.classList.toggle('alto-contraste');
}

/**
 * Despliega la ventana emergente de ayuda
 */
function mostrarAyuda() {
  const modal = document.getElementById('modal-ayuda');
  if (modal) modal.showModal();
}

/**
 * Cierra la ventana emergente de ayuda
 */
function cerrarAyuda() {
  const modal = document.getElementById('modal-ayuda');
  if (modal) modal.close();
}

/**
 * Actualiza el estado visual del indicador de audio
 * @param {boolean} activo 
 * @param {string} mensaje 
 */
function actualizarIndicadorAudio(activo, mensaje) {
  const indicador = document.getElementById('indicador-audio');
  if (!indicador) return;
  
  const texto = indicador.querySelector('.texto-estado');

  if (activo) {
    indicador.classList.add('activo');
    indicador.classList.remove('desactivado');
  } else {
    indicador.classList.remove('activo');
    indicador.classList.add('desactivado');
  }

  if (texto) texto.innerText = mensaje;
}
